{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.koroaisu.homecontrol",
  "Name": "Home Control",
  "Author": "koroaisu",
  "Description": "SwitchBotの電球を選んで操作します。Home Controlを自動起動します。",
  "Version": "0.4.7.0",
  "SDKVersion": 2,
  "Software": {"MinimumVersion": "7.6"},
  "OS": [{"Platform": "windows", "MinimumVersion": "10"}],
  "Nodejs": {"Version": "24"},
  "CodePath": "plugin.mjs",
  "Icon": "images/plugin",
  "Category": "Home Control",
  "CategoryIcon": "images/category",
  "Actions": [{
    "UUID": "com.koroaisu.homecontrol.light",
    "Name": "電球を操作",
    "Tooltip": "電球を選択してオン・オフ・明るさなどを操作",
    "Icon": "images/action",
    "Controllers": ["Keypad"],
    "PropertyInspectorPath": "inspector.html",
    "DisableAutomaticStates": true,
    "States": [
      {"Image": "images/off", "TitleAlignment": "bottom", "FontSize": 12},
      {"Image": "images/on", "TitleAlignment": "bottom", "FontSize": 12},
      {"Image": "images/unknown", "TitleAlignment": "bottom", "FontSize": 12}
    ]
  }, {
    "UUID": "com.koroaisu.homecontrol.brightness",
    "Name": "明るさを調整",
    "Tooltip": "ダイヤルを回して電球の明るさを調整。押し込みの動作も選べます。",
    "Icon": "images/action",
    "Controllers": ["Encoder"],
    "PropertyInspectorPath": "inspector.html",
    "Encoder": {
      "layout": "brightness-layout.json",
      "TriggerDescription": {"Rotate": "明るさを調整", "Push": "何もしない", "Touch": "状態を再取得"}
    },
    "States": [{"Image": "images/dial-on"}]
  }]
}
